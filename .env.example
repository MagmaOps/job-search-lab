# ── Database ───────────────────────────────────────────────────────────────
# In production this points at the CloudNativePG -rw Service.
DATABASE_URL=postgresql+psycopg://jobsearch:jobsearch@db:5432/jobsearch

# ── AI provider ────────────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to run with the StubProvider (no external calls).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# ── Collection scheduling ──────────────────────────────────────────────────
# Cron expression; default every 6 hours (a few times per day).
COLLECT_SCHEDULE=0 */6 * * *

# ── Worker HA ──────────────────────────────────────────────────────────────
# Leader election ensures only one worker collects at a time (k8s Lease in prod).
LEADER_ELECTION=false

# ── Misc ───────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API (the web UI origin).
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
